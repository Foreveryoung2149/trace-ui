# Demo works without this file or an account. Never use NEXT_PUBLIC_ for secrets.
TRACE_MODE=demo
# For sandbox/live: generate a strong password, then sign in as username trace.
STARTER_ACCESS_TOKEN=
TRACE_API_KEY=
TRACE_SANDBOX_SCENARIO=delivered
# Live mode uses one server-configured number, never an anonymous browser proxy.
TRACE_TRACKING_NUMBER=
TRACE_CARRIER=
# Webhooks are optional. Use a separate database owned by your starter application.
TRACE_WEBHOOK_SECRET=
DATABASE_URL=

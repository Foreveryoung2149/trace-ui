# Root UI demo works without this file, a key or a database.
# Never use NEXT_PUBLIC_ for passwords, API keys or signing secrets.
TRACE_MODE=demo
# Separate, private two-parcel workflow. Fixture mode is restricted to loopback.
STARTER_DATA_MODE=fixture
STARTER_TENANT_ID=fixture_tenant
STARTER_ORIGIN=http://localhost:3000
# Public fictional credentials: accepted only in fixture mode. Replace all for live.
STARTER_AUTH_SECRET=fixture-auth-secret-only-for-local-development
STARTER_CUSTOMER_HANDLE=demo-customer
STARTER_CUSTOMER_PASSWORD=fixture-customer-password-only-for-local-development
TRACE_WEBHOOK_SECRET=fixture-signing-secret-only-for-local-development
DATABASE_URL=
# A short lease makes the explicit crash/restart demonstration quick. Live uses 60s.
STARTER_FIXTURE_LEASE_MS=1000
# Only for the original root sandbox/live integration preview (username trace).
STARTER_ACCESS_TOKEN=
TRACE_API_KEY=
TRACE_SANDBOX_SCENARIO=delivered
# Root live preview uses one server-configured number, not an anonymous proxy.
TRACE_TRACKING_NUMBER=
TRACE_CARRIER=
# Optional bounded signing-secret overlap. Expiry must be an explicit UTC instant.
TRACE_WEBHOOK_PREVIOUS_SECRET=
TRACE_WEBHOOK_PREVIOUS_SECRET_UNTIL=
# Explicit live order provisioning (server/CLI only, never submitted by browser).
STARTER_CUSTOMER_ID=
STARTER_ORDER_ID=
STARTER_ORDER_REFERENCE=
# JSON array of owned shipment numbers, e.g. ["YOUR_FIRST","YOUR_SECOND"].
TRACE_TRACKING_NUMBERS=
